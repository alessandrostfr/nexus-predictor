# App
APP_NAME="Nexus Predictor API"
APP_ENV="local"
APP_VERSION="0.3.0"
BACKEND_CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# SQLite is enough for the MVP and keeps setup simple.
DATABASE_URL="sqlite:///./nexus_predictor.db"
AUTO_SEED_DATABASE=true

# Block 3 external enrichment.
# Keep this false for normal local development. Turn it on only when you want
# refresh endpoints/scripts to call external APIs.
ENABLE_EXTERNAL_ARTIST_ENRICHMENT=false
EXTERNAL_API_TIMEOUT_SECONDS=10

# Spotify API credentials. Never commit real values.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Last.fm API key. Never commit real values.
LASTFM_API_KEY=""

# MusicBrainz does not require a key, but it expects a clear User-Agent.
MUSICBRAINZ_APP_NAME="NexusPredictor"
MUSICBRAINZ_CONTACT_EMAIL=""
