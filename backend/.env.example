# Nexus Predictor backend V2 local settings
APP_NAME=Nexus Predictor
APP_VERSION=2.2.0-spotify
ENVIRONMENT=development

# Official V2 database
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus_predictor

# Local frontend origins
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# V2 uses Alembic migrations. Keep false for the official PostgreSQL workflow.
AUTO_CREATE_DATABASE_SCHEMA=false
AUTO_SEED_DATABASE=true

# Optional legacy external enrichment switch.
ENABLE_EXTERNAL_ARTIST_ENRICHMENT=false

# External request defaults
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20
MUSICBRAINZ_USER_AGENT=NexusPredictor/2.2 (local research app)
LASTFM_API_KEY=

# Spotify V2.2
# Create these in Spotify Developer Dashboard and never commit the real values.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_API_BASE_URL=https://api.spotify.com/v1
SPOTIFY_DEFAULT_MARKET=ES
SPOTIFY_ARTIST_SEARCH_LIMIT=5
SPOTIFY_TOP_TRACK_LIMIT=10
SPOTIFY_RELEASE_LIMIT=8
