# Nexus Predictor backend local configuration.
# Copy this file to backend/.env and fill secrets locally. Do not commit .env.

APP_NAME=Nexus Predictor
APP_VERSION=3.4-b
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus_predictor
BACKEND_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
AUTO_CREATE_DATABASE_SCHEMA=false
AUTO_SEED_DATABASE=true

# V3.4-B official API probes.
# Spotify and Last.fm are expected to be configured locally from V2.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# YouTube Data API v3.
# Create a Google Cloud project, enable YouTube Data API v3, create an API key,
# restrict it where possible, then paste it only in backend/.env.
YOUTUBE_API_KEY=

# SoundCloud official/API access.
# If official access is unavailable, keep these empty and V3.4-C will use the
# approved metadata-only fallback strategy.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# MusicBrainz requires a descriptive User-Agent even without an API key.
MUSICBRAINZ_USER_AGENT=NexusPredictorV3/0.1 (local educational ML project; contact: your-email@example.com)

# V3.4-C will use this for yt-dlp metadata-only fallback. Keep disabled in B.
ENABLE_YTDLP_METADATA_COLLECTOR=false
EXTERNAL_TIMEOUT_SECONDS=12
