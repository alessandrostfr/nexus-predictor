# Nexus Predictor production environment example.
# Copy this file to .env.production on the VPS and replace secrets there only.

POSTGRES_DB="nexus_predictor"
POSTGRES_USER="nexus_user"
POSTGRES_PASSWORD="replace-on-vps-with-openssl-rand-hex-32"

DATABASE_URL="postgresql+psycopg://nexus_user:replace-on-vps-with-openssl-rand-hex-32@nexus-postgres:5432/nexus_predictor"
APP_NAME="Nexus Predictor API"
APP_VERSION="0.3.0-production"
BACKEND_CORS_ORIGINS="https://nexus.alessandrostfr.com,http://nexus-web:3000,http://localhost:3000,http://127.0.0.1:3000"

NEXT_PUBLIC_API_BASE_URL="https://api-nexus.alessandrostfr.com/api"

# Optional external integrations. Leave empty unless you want live refreshes.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_DEFAULT_MARKET="ES"
LASTFM_API_KEY=""
LASTFM_TOP_TRACK_LIMIT="10"
LASTFM_USER_AGENT="NexusPredictor/0.3 production contact:alessandrostfr.com"
