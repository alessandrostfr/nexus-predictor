# Nexus Predictor V2 local development environment
# Copy this file to .env in the project root when using Docker Compose.

# PostgreSQL container
POSTGRES_DB=nexus_predictor
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_PORT=5432

# Backend application
APP_NAME=Nexus Predictor
APP_VERSION=2.0.0-foundations
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus_predictor
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
AUTO_CREATE_DATABASE_SCHEMA=false
AUTO_SEED_DATABASE=true

# External enrichment remains disabled until the corresponding V2 blocks.
ENABLE_EXTERNAL_ARTIST_ENRICHMENT=false
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20
MUSICBRAINZ_CONTACT_EMAIL=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Prefect is introduced in V2.0 as architecture foundation.
# Leave empty for local ephemeral execution; configure later if a Prefect server is used.
PREFECT_API_URL=
